<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">

        <!-- Кнопка + -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNewNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_add"
            android:contentDescription="Новая заметка" />

        <!-- Поиск -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            app:queryHint="Поиск заметок..."
            app:iconifiedByDefault="false" />

        <!-- Счётчик -->
        <TextView
            android:id="@+id/tvNotesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Переключатель вида -->
        <ImageButton
            android:id="@+id/btnToggleView"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_grid"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Переключить вид"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Tag chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="8dp"
        android:paddingBottom="4dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:chipSpacingHorizontal="4dp" />

    </HorizontalScrollView>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_empty_notes"
            android:alpha="0.35" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Нет заметок"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Нажми + чтобы создать первую"
            android:textSize="14sp"
            android:textColor="?attr/colorOutline" />

    </LinearLayout>

    <!-- Notes list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="6dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:visibility="gone" />

</LinearLayout>
